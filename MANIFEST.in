# D:\projects\claw\open-agents\openagent-workspace\MANIFEST.in
include LICENSE
include README.md
include docs/*.md
include agentworkspace/web/*.html
include agentworkspace/web/*.js
# 源样式（aw.css）同样是 web/ 里的一员：它只在 package-data 里写着的时候，源码包
# 靠 setuptools「顺手把 package_data 带进来」这个**隐含**行为才有它 —— 换成一份
# 不这么干的构建后端，从 sdist 装的人就没有样式了。这里明写一遍。
include agentworkspace/web/*.css
include agentworkspace/assets/*.ico
recursive-include agentworkspace *.py
# 源码包要能自己跑测试：`node tests/turn.test.js` 就是这套忙碌状态机的规格。
# 原来这里一个 tests/ 都没有 —— 从 sdist 装的用户拿不到任何测试（而 wheel 里
# 也没有，那是刻意的：wheel 是给人用的，sdist 是给改代码的人用的）。
recursive-include tests *.js
# *.py 同样要带：selftest_with_fixtures.py 与 tests/e2e_copy.py / e2e_browser_copy.py
# 才是「怎么验」的正文。只带 .js 的话，从 sdist 拿到的人只有前端的规格，
# 后端的验收线一条也看不见 —— 上一版就是这么缺的。
recursive-include tests *.py
global-exclude __pycache__ *.py[cod] *.log
