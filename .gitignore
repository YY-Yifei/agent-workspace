# ── 运行时数据：绝不入库 ─────────────────────────────
# workspace/ 是这台机器上真正在跑的那份：plugins/（本地程序与它们的数据）、
# logs/、config.json（aaas 地址）、dev.json（开发者模式开关）、prompts/、notes/
/workspace/

# 包默认把**启动时的当前目录**当工作区，所以在仓库根跑一次 open-agent-workspace
# 就会把这些运行时产物落在仓库根 —— 它们不是内核，不该被 git add 带进来
/logs/
/plugins/
/config.json
/dev.json
/dev.json.tmp
/.config-*.json
/.shell/
/notes/
/prompts/

# 原型目录：proto/ 是当初试探协议用的草稿 + 一个样例程序及其 data/，不是内核
/proto/

# 这台机器自己的东西
/.tmp/
/.openthree/

# ── 凭据：任何形态都不许入库 ─────────────────────────
.env
.env.*
!/.env.example
!/.env.sample
!/.env.template
*.key
*.pem
/secrets.*
.pypirc
*.token

# ── 构建与缓存 ───────────────────────────────────────
__pycache__/
*.py[cod]
/build/
/dist/
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# WebView2 / pywebview 的用户配置目录（pywebview 会建 WebView2/ 或 EBWebView/）
wvprofile*/
WebView2/
EBWebView/
.wvprofile*/
wv_persist.json

# ── 日志与备份 ───────────────────────────────────────
*.log
/.backup/

# ── 编辑器 / 系统 ────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
